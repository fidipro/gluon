# Release-binary smoke test and install.sh in plain Debian slim (no Bun). Run by scripts/docker-test.sh:
# /release and /install.sh are mounted read-only at run time.
FROM debian:12-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
# Debian's musl package puts /lib/ld-musl-*.so.1 on a glibc system: install.sh must still take
# the glibc build (BUG-117).
RUN apt-get update && apt-get install -y --no-install-recommends musl && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 2000 tester
COPY smoke.sh /usr/local/bin/gluon-smoke
USER tester
WORKDIR /home/tester
CMD ["/usr/local/bin/gluon-smoke"]
