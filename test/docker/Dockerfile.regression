# `bun run regression:full` in Bun's official image, and the npm package installed with `bun add -g`.
# BASE picks the flavor (scripts/docker-test.sh builds both):
#   oven/bun:1.3.14-debian   glibc
#   oven/bun:1.3.14-alpine   musl
# The build context is the repository's tracked and unignored files only (no .env, no node_modules).
ARG BASE=oven/bun:1.3.14-debian@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f
FROM ${BASE}
USER root
# git for the test repositories; bash for the fake agents; curl and openssl for install.sh over
# https (test/docker/https.sh); procps for `ps` (the e2e harness's `descendants`: Debian's slim image has none); on Alpine GNU coreutils, whose env has
# the -S the npm package's shebang needs (BusyBox env has none).
RUN if command -v apk >/dev/null; then apk add --no-cache git bash coreutils curl openssl; \
    else apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl openssl procps && rm -rf /var/lib/apt/lists/*; fi
USER bun
WORKDIR /home/bun/gluon
COPY --chown=bun:bun package.json bun.lock bunfig.toml .bun-version ./
COPY --chown=bun:bun patches ./patches
RUN bun install --frozen-lockfile
COPY --chown=bun:bun . .
CMD ["bun", "run", "regression:full"]
