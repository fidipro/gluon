# The keys Gluon reads from the .env next to its config (~/.config/gluon/.env; on Windows
# %APPDATA%\gluon\.env). `gluon setup` / `connect` save them there, or copy this file there and
# fill in what you have. Gluon keeps these to itself (never in process.env): an agent gets only
# the key of the provider its model runs on. Precedence: a key in that file wins over your
# environment. Gluon reads no other .env. For development, `bun run test:live` reads keys from
# GLUON_DEV_ENV (default: a copy of this file as .env at the repo root, gitignored).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
# The OpenCode Go plan needs no key here: it signs in through `opencode auth login opencode-go`.
# Amazon Bedrock uses your AWS setup (profile and region in config.yaml), not a key here.
